if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "rank":
        ap = argparse.ArgumentParser(prog="score rank", description="Rank several results.json files.")
        ap.add_argument("files", nargs="+", help="results.json files written by score")
        ap.add_argument("--out", help="leaderboard HTML path (default leaderboard.html; a .csv is written beside it)")
        main_rank(ap.parse_args(sys.argv[2:]))
    else:
        ap = argparse.ArgumentParser(prog="score", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
        ap.add_argument("design", help="a design .json file, or a folder that contains design.json")
        ap.add_argument("--courses", help="comma-separated courses to (re)check; default: all scored courses")
        ap.add_argument("--jobs", type=int, help="courses checked at the same time (default: based on CPU count)")
        ap.add_argument("--name", help="name shown on the dashboard and leaderboard (default: the file or folder name)")
        ap.add_argument("--out", help="folder for results.json and results.html (default: next to the design)")
        ap.add_argument("--open", action="store_true", help="open the dashboard in the browser when done")
        main_score(ap.parse_args())

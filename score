PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>BrickBench results</title><style>""" + CSS + """</style></head><body><main id="app"></main>
<script>
const D = __DATA__;
const esc = s => String(s ?? "").replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const LABEL = {crossed:"\\u2713 Crossed", not_crossed:"\\u2717 Not crossed", invalid:"\\u2717 Invalid design",
  error:"\\u2717 Simulator error", missing:"\\u2013 No design", not_run:"\\u2013 Not checked yet", stale:"\\u27f3 Outdated"};
const st = r => r.stale ? "stale" : r.status;
const badge = r => `<span class="badge b-${st(r)}">${LABEL[st(r)]}</span>`;
const secs = x => x == null ? "\\u2013" : x.toFixed(1) + " s";
const pct = x => x == null ? "\\u2013" : Math.round(Math.min(1, Math.max(0, x)) * 100) + "%";
function reason(r) {
  if (r.stale) return "Design changed since this check";
  if (r.status === "missing") return "No design.json in the folder";
  if (r.status === "not_run") return "Run python score with --courses " + r.course;
  if (r.status === "invalid") return "Does not validate";
  if (r.status === "crossed") return "";
  for (const n of ["plain", "offset_1mm", "commands_50ms_late"]) {
    const x = (r.runs || {})[n]; if (x && !x.passed) return (n === "plain" ? "" : D.run_names[n] + ": ") + x.failure;
  }
  return r.status === "error" ? "Simulator error" : "Design review: critical finding";
}
function card(r) {
  const t = D.tasks[r.course];
  let h = `<article class="card" id="c-${r.course}"><div class="head"><h3>${r.course}</h3>${badge(r)}</div>
    <p class="desc">${esc(t.description)}</p>`;
  if (r.status === "crossed" || r.status === "not_crossed") {
    h += `<div class="metric"><span>Time to goal</span><b>${secs(r.time_s)}</b><span class="note">limit ${secs(t.time_limit_s)}</span></div>
      <div class="track" title="Furthest point reached in the plain run: ${pct(r.max_progress)} of the course">
      <div class="fill" style="width:${pct(r.max_progress)}"></div></div>
      <div class="note">Furthest point (plain run): ${pct(r.max_progress)} of the course</div><ul class="runs">`;
    for (const n of ["plain", "offset_1mm", "commands_50ms_late"]) {
      const x = r.runs[n]; if (!x) continue;
      h += `<li>${x.passed ? '<span class="ok">\\u2713</span>' : '<span class="no">\\u2717</span>'} ${D.run_names[n]}${x.passed ? "" : " \\u2014 " + esc(x.failure)}</li>`;
    }
    h += "</ul>";
  }
  if (r.stale) h += `<p class="why"><b>Outdated.</b> The design file changed after this check, so it does not count. Re-run: <code>python score ${esc(D.target)} --courses ${r.course}</code></p>`;
  if (r.why && D.why[r.why]) h += `<p class="why"><b>What went wrong:</b> ${esc(D.why[r.why])}</p>`;
  if (r.status === "missing") h += `<p class="why">Add <code>design.json</code> to the design folder.</p>`;
  if (r.status === "not_run") h += `<p class="why">Not checked yet. Run <code>python score ${esc(D.target)} --courses ${r.course}</code>.</p>`;
  if (r.errors && r.errors.length) h += `<p class="note bad">What validate reports:</p><ul class="err">${r.errors.map(e => `<li>${esc(e)}</li>`).join("")}</ul>`;
  if (r.review_critical && r.review_critical.length) h += `<p class="note bad">Critical review findings:</p><ul class="err">${r.review_critical.map(e => `<li>${esc(e)}</li>`).join("")}</ul>`;
  if (r.videos && r.videos.length) {
    h += `<video controls preload="metadata" src="${esc(r.videos[0])}"></video><div class="links">`;
    r.videos.forEach(v => h += `<a href="${esc(v)}" target="_blank">${v.includes("overview") ? "Overview" : "Follow"} video</a>`);
    if (r.contact_sheet) h += `<a href="${esc(r.contact_sheet)}" target="_blank">Contact sheet</a>`;
    h += "</div>";
  }
  if (r.log_tail) h += `<details><summary>Simulator log</summary><pre>${esc(r.log_tail)}</pre></details>`;
  if (r.checked_at) h += `<p class="note" style="margin:10px 0 0">Checked ${esc(r.checked_at)} \\u00b7 ${esc(r.design)}</p>`;
  return h + "</article>";
}
const S = D.score;
let h = `<h1>BrickBench results: ${esc(D.name)}</h1><p class="sub">${esc(D.target)} \\u00b7 generated ${esc(D.generated)}</p>
<div class="tiles"><div class="tile"><div class="hero">${S.crossed}<small> of ${S.of} courses crossed</small></div></div>
<div class="tile"><div class="hero">${S.total_time_s.toFixed(1)}<small> s total time</small></div><div class="note">time to goal, summed over the crossed courses</div></div></div>
<p class="note">Ranking: most courses crossed first, then the lowest total time. A course is crossed when <code>brick check</code>
accepts it: the plain run, the run 1 mm off-centre and the run with commands 50 ms late all reach the goal.
This page is your own preview: the staff re-run every submitted design independently, and that result is the official score.</p>
<h2>All courses</h2><div class="tablewrap"><table><thead><tr><th>Course</th><th>Result</th><th class="num">Time to goal</th>
<th class="num">Limit</th><th class="num">Furthest</th><th>Why not crossed</th></tr></thead><tbody>`;
for (const r of D.courses) h += `<tr><td><a href="#c-${r.course}">${r.course}</a></td><td>${badge(r)}</td>
  <td class="num">${r.status === "crossed" && !r.stale ? secs(r.time_s) : "\\u2013"}</td><td class="num">${secs(D.tasks[r.course].time_limit_s)}</td>
  <td class="num">${pct(r.max_progress)}</td><td>${esc(reason(r))}</td></tr>`;
h += `</tbody></table></div><h2>Course details</h2><div class="cards">${D.courses.map(card).join("")}</div>`;
document.getElementById("app").innerHTML = h;
</script></body></html>"""


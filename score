#!/usr/bin/env python3
"""score: check a design on every course and build a results dashboard (results.html).

With the environment active (see README.md), run one of:

    python score design.json                       check the design on all four courses
    python score design.json --open                ... and open the dashboard when done
    python score design.json --courses rope        re-check some courses; the others keep their last result
    python score submissions/alice/                a folder: uses the design.json inside it
    python score rank a/results.json b/results.json ...   rank several results files (used by the staff)

It writes results.json and results.html next to the design (or into --out DIR). Open results.html in a browser.
One design, with one motor program, runs on all four courses.

Scoring. A course counts as crossed when `brick check` accepts the design on it: the plain run, the run 1 mm off
the centreline and the run with every command 50 ms late all reach the goal, and the design review has no critical
finding. Results are ranked by the number of courses crossed, then by the total time to goal over those courses
(the plain run's time_s), lower first. Designs that cross the same number of courses with the same total time (for
example, none) are tied. A result whose design file has changed since it was checked does not count.

This is your own preview. The staff re-run `brick check` on every submitted design on their own machine, and that
independent result is the official score.
"""
import argparse, csv, hashlib, json, os, shutil, subprocess, sys, time
from concurrent.futures import ThreadPoolExecutor, as_completed

H = os.path.dirname(os.path.abspath(__file__))
BRICK = os.path.join(H, "brick")
# The scored courses.
COURSES = ["steps", "rope", "ramp", "bridge"]
RUN_NAMES = {"plain": "Plain run", "offset_1mm": "1 mm off-centre", "commands_50ms_late": "Commands 50 ms late"}
WHY = {  # first word of the simulator's failure reason -> plain-English explanation and a first thing to try
    "stuck": "The car stopped making progress for several seconds. Common causes: the motor program brakes or stops "
             "too early, the wheels slip or lack torque, or a part catches on the obstacle. Watch the video to see which.",
    "timeout": "The car was still moving but did not reach the goal within the time limit. Make it faster (gearing, "
               "motor level) or make sure it keeps driving until it is past the goal.",
    "fell": "The car fell off the course (off an edge, the plank or the rope).",
    "touched": "A part touched the floor of the chasm (rope and bridge). Every part must stay above it, even for an "
               "instant: watch the video to see which part dips and when.",
    "flipped": "The car tipped over and stayed on its side or roof. A lower centre of mass or a wider wheel track helps.",
    "broke": "Part of the car came apart (a stud joint released or a mechanism separated). Strengthen that joint with "
             "more studs or pins.",
    "left_lane": "The car left the course lane, or a part went around the obstacle instead of over it. Check that it "
                 "drives straight.",
    "simulation": "The physics became unstable. This usually means overlapping parts or extreme forces; read the "
                  "validate warnings.",
    "wall-clock": "The simulation took too long on this computer and was stopped.",
    "review": "Every run reached the goal, but the design review found a critical problem (listed below), so the "
              "check does not accept the design.",
    "error": "The simulator did not produce a result. The log below shows why.",
}


def sha(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()[:12]


def task(c):
    return json.load(open(os.path.join(H, "tasks", c + ".json")))


def design_for(target, course):
    if os.path.isdir(target):  # one design for every course: the folder's design.json
        p = os.path.join(target, "design.json")
        return p if os.path.isfile(p) else None
    return target


def brick_check(path, course, env):
    r = subprocess.run([sys.executable, BRICK, "check", path, course], capture_output=True, text=True, env=env)
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return {"error": "brick check did not return a result", "log_tail": (r.stdout + r.stderr)[-2000:]}


def record(course, path, out, out_dir):
    # links in results.html: relative to it, with forward slashes (Windows too)
    rel = lambda p: os.path.relpath(p, out_dir).replace(os.sep, "/") if p and os.path.exists(p) else None  # noqa: E731
    rec = {"course": course, "design": rel(path), "design_sha": sha(path),
           "checked_at": time.strftime("%Y-%m-%d %H:%M"), "time_s": None, "max_progress": None, "runs": {},
           "videos": [], "contact_sheet": None, "errors": [], "review_critical": [], "log_tail": None}
    if "plain" not in out:  # did not validate, or brick itself failed
        rec["status"] = "invalid" if out.get("errors") else "error"
        rec["errors"] = out.get("errors") or [out.get("error") or "unknown error"]
        rec["review_critical"] = (out.get("review") or {}).get("critical", [])
        rec["log_tail"] = out.get("log_tail")
        return rec
    p = out["plain"]
    for n, x in {"plain": p, **(out.get("nudges") or {})}.items():
        rec["runs"][n] = {"passed": bool(x.get("passed")), "failure": None if x.get("passed") else
                          (x.get("failure") or x.get("error") or "no result"), "time_s": x.get("time_s"),
                          "max_progress": x.get("max_progress")}
        if x.get("error") and not rec["log_tail"]:
            rec["log_tail"] = x.get("log_tail")
    rec["accepted"] = bool(out.get("accepted"))
    rec["status"] = "crossed" if rec["accepted"] else "not_crossed"
    rec["time_s"] = p.get("time_s") if p.get("passed") else None
    rec["max_progress"] = p.get("max_progress")
    rec["review_critical"] = out.get("review_critical") or []
    rec["videos"] = [v for v in (rel(v) for v in p.get("videos") or []) if v]
    sheets = [s for s in (rel(s) for s in p.get("contact_sheets") or []) if s]
    rec["contact_sheet"] = sheets[-1] if sheets else None
    return rec


def why_key(rec):
    if rec["status"] == "error":
        return "error"
    for n in ("plain", "offset_1mm", "commands_50ms_late"):
        f = (rec["runs"].get(n) or {}).get("failure")
        if f:
            k = f.split()[0].split("(")[0]
            k = "timeout" if k == "time" else k  # the simulator's own "time limit"
            return k if k in WHY else "error"
    return "review" if rec["status"] == "not_crossed" else None


def summarize(results, target, courses):
    rows = []
    for c in courses:
        path = design_for(target, c)
        r = results.get(c)
        if path is None:
            rows.append({"course": c, "status": "missing"})
            continue
        if r is None:
            rows.append({"course": c, "status": "not_run", "design": path})
            continue
        r = dict(r)
        if r.get("design_sha") != sha(path):
            r["stale"] = True
        r["why"] = why_key(r)
        rows.append(r)
    crossed = [r for r in rows if r["status"] == "crossed" and not r.get("stale")]
    return rows, {"crossed": len(crossed), "of": len(courses),
                  "total_time_s": round(sum(r["time_s"] for r in crossed), 2)}


def main_score(a):
    target = os.path.abspath(a.design)
    if not os.path.exists(target):
        sys.exit(f"score: {a.design} does not exist")
    if os.path.isdir(target) and not os.path.isfile(os.path.join(target, "design.json")):
        sys.exit(f"score: {a.design} is a folder without a design.json in it")
    if not os.path.isfile(BRICK):
        sys.exit("score: put this file in the same folder as `brick`")
    if not shutil.which("ffmpeg"):
        sys.exit("score: ffmpeg is not installed. Without it the simulator returns no result.\n"
                 "  macOS: brew install ffmpeg    Linux: sudo apt install ffmpeg    Windows: winget install --id=Gyan.FFmpeg -e\n"
                 "Then open a new terminal so that ffmpeg is on PATH.")
    courses = COURSES if not a.courses else [c.strip() for c in a.courses.split(",") if c.strip()]
    bad = [c for c in courses if c not in COURSES]
    if bad:
        sys.exit(f"score: unknown course(s) {', '.join(bad)}; the courses are {', '.join(COURSES)}")
    out_dir = os.path.abspath(a.out or (target if os.path.isdir(target) else os.path.dirname(target)))
    os.makedirs(out_dir, exist_ok=True)
    rpath = os.path.join(out_dir, "results.json")
    old = json.load(open(rpath)) if os.path.exists(rpath) else {}
    results = {r["course"]: r for r in old.get("courses", []) if r.get("design_sha")}
    todo = [(c, design_for(target, c)) for c in courses]
    todo = [(c, p) for c, p in todo if p]
    env = dict(os.environ)
    if not sys.platform.startswith("linux"):
        env.setdefault("MUJOCO_GL", "glfw")  # EGL exists only on Linux; glfw renders on macOS and Windows
    jobs = a.jobs or max(1, min(4, (os.cpu_count() or 3) // 3))
    print(f"Checking {len(todo)} course(s), 3 simulations each, {jobs} course(s) at a time. "
          f"This takes roughly {max(1, round(len(todo) / jobs + 0.5))}-{max(2, round(len(todo) * 3 / jobs + 0.5))} min.")
    t0 = time.time()
    with ThreadPoolExecutor(jobs) as ex:
        futs = {ex.submit(brick_check, p, c, env): (c, p) for c, p in todo}
        for f in as_completed(futs):
            c, p = futs[f]
            r = results[c] = record(c, p, f.result(), out_dir)
            t = f"{r['time_s']:.1f} s" if r["time_s"] is not None else "-"
            reason = "" if r["status"] == "crossed" else (why_key(r) or "")
            print(f"  {c:8s} {r['status'].replace('_', ' '):12s} {t:>8s}  {reason}   ({time.time() - t0:.0f} s elapsed)")
    name = a.name or old.get("name") or (os.path.basename(target) if os.path.isdir(target)
                                         else os.path.splitext(os.path.basename(target))[0])
    rows, score = summarize(results, target, COURSES)
    data = {"name": name, "generated": time.strftime("%Y-%m-%d %H:%M"), "target": a.design,
            "score": score, "courses": rows, "why": WHY, "run_names": RUN_NAMES,
            "tasks": {c: {"description": task(c)["description"], "time_limit_s": task(c)["time_limit_s"]} for c in COURSES}}
    json.dump(data, open(rpath, "w"), indent=1)
    html_path = os.path.join(out_dir, "results.html")
    open(html_path, "w", encoding="utf-8").write(PAGE.replace("__DATA__", json.dumps(data).replace("</", "<\\/")))
    print(f"\nScore: {score['crossed']} of {score['of']} courses crossed, total time {score['total_time_s']} s")
    print(f"Dashboard: {html_path}")
    if a.open:
        import webbrowser
        import pathlib
        webbrowser.open(pathlib.Path(html_path).as_uri())


def main_rank(a):
    rows = []
    for f in a.files:
        d = json.load(open(f))
        times = {r["course"]: (r.get("time_s") if r.get("status") == "crossed" and not r.get("stale") else None)
                 for r in d["courses"]}
        rows.append({"name": d.get("name") or os.path.basename(os.path.dirname(os.path.abspath(f))), "file": f,
                     "crossed": d["score"]["crossed"], "total_time_s": d["score"]["total_time_s"], "times": times})
    rows.sort(key=lambda r: (-r["crossed"], r["total_time_s"]))
    for i, r in enumerate(rows):
        same = i and (r["crossed"], r["total_time_s"]) == (rows[i - 1]["crossed"], rows[i - 1]["total_time_s"])
        r["rank"] = rows[i - 1]["rank"] if same else i + 1
    out = os.path.abspath(a.out or "leaderboard.html")
    with open(os.path.splitext(out)[0] + ".csv", "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["rank", "name", "courses_crossed", "total_time_s"] + COURSES)
        for r in rows:
            w.writerow([r["rank"], r["name"], r["crossed"], r["total_time_s"]] + [r["times"].get(c) or "" for c in COURSES])
    data = {"generated": time.strftime("%Y-%m-%d %H:%M"), "courses": COURSES, "rows": rows}
    open(out, "w", encoding="utf-8").write(RANK_PAGE.replace("__DATA__", json.dumps(data).replace("</", "<\\/")))
    for r in rows:
        print(f"{r['rank']:>3}  {r['name']:24s} {r['crossed']:>2} crossed  {r['total_time_s']:>8} s")
    print(f"\nLeaderboard: {out} (and {os.path.splitext(out)[0]}.csv)")


